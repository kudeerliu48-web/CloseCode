{
  "name": "closecode",
  "version": "2.0.2",
  "description": "CloseCode - AI Agent Development Workbench",
  "type": "commonjs",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "cli": "node cli.js",
    "eval": "node eval/run.js",
    "icons": "bash scripts/make-icons.sh",
    "icons:ui": "node scripts/build-ui-icons.js",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.js --mac",
    "dist:win": "electron-builder --config electron-builder.config.js --win",
    "dist:linux": "electron-builder --config electron-builder.config.js --linux",
    "pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.js --dir",
    "patch:keygen": "node scripts/patch-keygen.js",
    "patch:build": "node scripts/build-patch.js"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@viz-js/viz": "^3.29.0",
    "docx": "^9.0.0",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "jszip": "^3.10.1",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  },
  "bin": {
    "wb": "./cli.js"
  },
  "author": {
    "name": "CatCatUncle",
    "email": "257534836+CatCatUncle@users.noreply.github.com"
  },
  "homepage": "https://github.com/CatCatUncle/docode",
  "repository": {
    "type": "git",
    "url": "https://github.com/CatCatUncle/docode.git"
  }
}
